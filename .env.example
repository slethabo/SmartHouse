# Copy to .env and adjust. Never commit .env.

# This prototype uses a shared workspace; authentication is disabled.

# API port (the Vite dev server proxies /api to this)
PORT=3001

# Secret used to sign JWT session cookies. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: point to an external PostgreSQL. When empty, an embedded PostgreSQL
# is started automatically (data stored in server/data/pg).
# DATABASE_URL=postgresql://user:password@localhost:5432/smarthouse

# Port for the embedded PostgreSQL (only used when DATABASE_URL is empty)
EMBEDDED_PG_PORT=5433

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Maximum share of a plot that a house footprint may cover (0.5 = 50%)
MAX_PLOT_COVERAGE=0.5
