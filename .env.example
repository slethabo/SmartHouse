# Copy to .env and adjust. Never commit .env.

# Supabase browser connection (public values from Project > Connect).
# Vite reads this root .env even when started with npm workspaces.
# Set local to use the offline demo, or supabase to require cloud configuration.
VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are also supported as VITE_SUPABASE_ANON_KEY.
# Never use a database password, service_role JWT, or sb_secret_ key here.
# Enable the Email provider in Supabase Authentication settings.
# Add your app origin and /auth/callback and /auth/reset to Auth redirect URLs.
# Cloud accounts use email/password; no anonymous users are created automatically.

# The settings below apply only to the retained legacy Express server.

# API port (the Vite dev server proxies /api to this)
PORT=3001

# Secret used to sign JWT session cookies. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: point to an external PostgreSQL. When empty, an embedded PostgreSQL
# is started automatically (data stored in server/data/pg).
# DATABASE_URL=postgresql://user:password@localhost:5432/smarthouse

# Port for the embedded PostgreSQL (only used when DATABASE_URL is empty)
EMBEDDED_PG_PORT=5433

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Maximum share of a plot that a house footprint may cover (0.5 = 50%)
MAX_PLOT_COVERAGE=0.5

VITE_SUPABASE_URL=https://fxtadwbidsrprpunkrku.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_OoR0ri3XwsrC-2stBAd_Fg_dgRevtll
